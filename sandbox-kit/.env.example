# The sandbox copy's settings (set on its Railway service, not here). Nothing below reaches anything real.
APSOHUB_SANDBOX=1
# Pages check that a HubSpot token is set; this one opens nothing - the sandbox answers HubSpot itself.
HUBSPOT_TOKEN=sandbox-replay
# 32+ random characters, one per sandbox service.
SESSION_SECRET=
# The SHA-256 (hex) of the hub's link key - the key itself stays on the hub.
SANDBOX_LINK_KEY_SHA256=
# Optional: jobs to test, by name (src/lib/sandbox/boot.ts). They still reach nothing real.
SANDBOX_JOBS=
# Optional: "on" lets background AI reach Anthropic - only with the sandbox's own capped key.
SANDBOX_AI=
ANTHROPIC_API_KEY=
