# Your sandbox's settings - copy this file to .env.local and fill it in. .env.local is never committed.

# Who the sandbox runs for: your address and name.
SANDBOX_PERSON=you@apsoparts.com|Your Name

# HubSpot: the access token of your own HubSpot private app, with read-only scopes. The sandbox holds back every
# write anyway; without a token the HubSpot pages stay empty.
HUBSPOT_TOKEN=

# The microservices (search bar, Google Ads buckets, DirectUP, DirectCut, 3D files): the read-only door and your viewer
# key come with the repository (sandbox-viewer.json, by your address above) - nothing to set here.

# Optional: jobs to test, by name (src/lib/sandbox/boot.ts) - they still change nothing real.
SANDBOX_JOBS=
# Optional: "on" lets background AI reach Anthropic - only with a capped key of your own.
SANDBOX_AI=
ANTHROPIC_API_KEY=
