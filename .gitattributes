# Shell scripts and the Dockerfile must stay LF so they run in Linux containers
# (a CRLF shebang breaks `#!/bin/sh` inside the image).
*.sh        text eol=lf
entrypoint.sh text eol=lf
Dockerfile  text eol=lf

# Campaign files are served byte-exact: the Black Friday voucher engine is NAMED after its content sha256
# (a CRLF checkout on Windows would change the bytes and break the name = hash check).
public/content/campaign/** -text
